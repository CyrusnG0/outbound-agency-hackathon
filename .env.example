# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See docs/data-flow.md §9 for the full model-pinning explanation.

# ── Primary provider: Gemini (Google hackathon requirement) ─────────────────
# Pinned model string for the gemini.flash alias in config/models.yaml.
# Every role (research_model/draft_model/reply_classifier_model/
# injection_scan_model) currently points at this one alias.
GEMINI_FLASH_MODEL=gemini-3.5-flash

# Mode A — Vertex AI (used in Cloud Run deployment; no API key, uses ADC)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
# MUST be 'global' — Gemini 3.x is not served from regional Vertex endpoints
# (us-central1 returns 404 NOT_FOUND for 3.5/3.6/3.7). See docs/data-flow.md §9a.
GOOGLE_CLOUD_LOCATION=global

# Mode B — Gemini API key (local dev): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Legacy/fallback provider: DeepSeek ──────────────────────────────────────
# Not used while config/models.yaml points the roles at gemini.flash.
# Repoint the aliases to deepseek.v4_flash to switch back.

# Pinned model string for the deepseek.v4_flash alias in config/models.yaml.
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash

# DeepSeek platform API key. Get one at https://platform.deepseek.com/.
# Used against DeepSeek's Anthropic-compatible endpoint
# (https://api.deepseek.com/anthropic) — see docs/data-flow.md §9.
DEEPSEEK_API_KEY=

# ── Timeouts ─────────────────────────────────────────────────────────────────
# Wall-clock ceiling for ONE target's whole Phase 1 run (seconds). Default 600
# (10 minutes) — ~10x the observed healthy 20–60s per-target time, far below
# the 9h48m hang this ceiling exists to prevent (docs/data-flow.md §9h). When
# it fires, the target lands in "failed" with reason=phase1_timeout — a clean
# failure, not a crash. Raise it for very large targets; lower it to fail hung
# targets faster. A non-numeric value is refused at run time.
PHASE1_TARGET_TIMEOUT_SECONDS=600
